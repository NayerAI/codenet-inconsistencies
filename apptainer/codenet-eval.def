Bootstrap: docker
From: ubuntu:22.04

# ===========================================================================
# Apptainer image for the CodeNet inconsistency evaluation framework.
#
# This image contains ONLY the runtime environment (Python + dependencies and
# the C / C++ / Python / Java toolchains). The framework CODE is NOT baked in --
# it is read at run time from the mounted working directory (./src), so editing
# the code never requires rebuilding the image. Rebuild only when the Python
# dependencies (requirements.txt) or the system toolchains change.
#
# Build (from the repo root):
#     apptainer build codenet-eval.sif apptainer/codenet-eval.def
#
# Run (from the repo root; ./src and ./data are picked up from the mount):
#     export OPENROUTER_API_KEY=sk-or-...
#     apptainer run codenet-eval.sif -c config/config.yaml all
#
# Apptainer auto-mounts $HOME and the current directory, so when the repo lives
# under $HOME no extra --bind is needed. Otherwise bind the repo explicitly:
#     apptainer run --bind /path/to/repo codenet-eval.sif ...
# ===========================================================================

%files
    # Only the dependency list -- NOT the framework source code.
    requirements.txt /opt/requirements.txt

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 python3-pip \
        gcc g++ \
        default-jdk \
        golang-go \
        nodejs \
        ca-certificates wget
    update-ca-certificates
    pip3 install --no-cache-dir --upgrade pip
    pip3 install --no-cache-dir -r /opt/requirements.txt
    # numpy for Python 3 (many CodeNet submissions import it).
    pip3 install --no-cache-dir numpy

    # Python 2 for the many Py2 CodeNet submissions, plus numpy (best-effort:
    # never fail the build if the legacy toolchain is unavailable).
    apt-get install -y --no-install-recommends python2 || true
    if command -v python2 >/dev/null 2>&1; then
        wget -qO /tmp/get-pip2.py https://bootstrap.pypa.io/pip/2.7/get-pip.py && \
            python2 /tmp/get-pip2.py && \
            python2 -m pip install --no-cache-dir "numpy<1.17" || \
            echo "WARN: python2 numpy setup skipped"
    fi

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PYTHONUNBUFFERED=1
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    # Locate the framework source in the mounted working directory. Precedence:
    #   1. $CODENET_EVAL_SRC (if set and valid)
    #   2. ./src under the current working directory
    if [ -n "${CODENET_EVAL_SRC:-}" ] && [ -d "${CODENET_EVAL_SRC}/codenet_eval" ]; then
        export PYTHONPATH="${CODENET_EVAL_SRC}:${PYTHONPATH:-}"
    elif [ -d "${PWD}/src/codenet_eval" ]; then
        export PYTHONPATH="${PWD}/src:${PYTHONPATH:-}"
    fi
    if ! python3 -c "import codenet_eval" 2>/dev/null; then
        echo "error: 'codenet_eval' not found on PYTHONPATH." >&2
        echo "Run from the repo root (so ./src is visible), or set" >&2
        echo "CODENET_EVAL_SRC=/abs/path/to/repo/src and bind that path in." >&2
        exit 1
    fi
    exec python3 -m codenet_eval.cli "$@"

%test
    # Only the runtime is baked in, so test the environment -- not the framework.
    python3 -c "import requests, yaml" && echo "python deps OK"
    python3 -c "import numpy" && echo "numpy OK"
    gcc --version >/dev/null && echo "gcc OK"
    javac -version 2>&1 | grep -qi javac && echo "javac OK"
    go version >/dev/null && echo "go OK"
    node --version >/dev/null && echo "node OK"

%labels
    Name codenet-eval-runtime
    Version 0.1.0
    Description Runtime (Python + toolchains) for the CodeNet inconsistency framework; code is mounted at run time

%help
    Runtime image for the CodeNet cross-language inconsistency framework.
    The framework CODE is read from the mounted ./src at run time -- editing code
    does NOT require rebuilding this image.

    Run from the repo root, e.g.:
      apptainer run codenet-eval.sif -c config/config.yaml inspect
      apptainer run codenet-eval.sif -c config/config.yaml all

    Commands: download | extract | inspect | demo | sample | run | report | all
    Set OPENROUTER_API_KEY in the environment before 'run'/'all'.

    No internet on this host? The container uses the host network. Either
    forward a proxy (--env HTTPS_PROXY=...), or pre-download the tarball into
    data/ and run 'extract' (or 'download --offline'), or set dataset.url to a
    local file:// path.
